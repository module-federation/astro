{
  "name": "@module-federation/astro",
  "version": "0.0.1",
  "type": "module",
  "description": "Astro integration for Module Federation using @module-federation/vite",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/astro.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/module-federation/astro/issues"
  },
  "homepage": "https://github.com/module-federation/astro#readme",
  "keywords": [
    "astro",
    "module federation",
    "microfrontend"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "test": "pnpm run build && node --test ./test/*.test.mjs"
  },
  "dependencies": {
    "@module-federation/runtime": "^2.1.0",
    "@module-federation/sdk": "^2.1.0",
    "@module-federation/vite": "^1.12.0"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
