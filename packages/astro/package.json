{
  "name": "@module-federation/astro",
  "version": "0.0.1",
  "type": "module",
  "description": "Astro integration for Module Federation using @module-federation/vite",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/astro.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/module-federation/astro/issues"
  },
  "homepage": "https://github.com/module-federation/astro#readme",
  "keywords": [
    "astro",
    "module federation",
    "microfrontend"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint src test tsdown.config.ts",
    "fmt": "oxfmt src test tsdown.config.ts",
    "fmt.check": "oxfmt --check src test tsdown.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@module-federation/runtime": "^2.1.0",
    "@module-federation/sdk": "^2.1.0",
    "@module-federation/vite": "^1.12.0"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
