{
  "name": "astro-module-federation",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev --filter=@module-federation/astro --filter=example-remote --filter=example-host",
    "dev:host": "turbo run dev --filter=@module-federation/astro --filter=example-host",
    "dev:remote": "turbo run dev --filter=@module-federation/astro --filter=example-remote",
    "build": "turbo run build --filter=@module-federation/astro",
    "build:host": "turbo run build --filter=example-host",
    "build:remote": "turbo run build --filter=example-remote",
    "test": "turbo run test --filter=@module-federation/astro",
    "ci": "turbo run build test --filter=@module-federation/astro --filter=\"example-*\"",
    "changeset": "changeset",
    "changeset:status": "changeset status"
  },
  "pnpm": {
    "overrides": {
      "@module-federation/dts-plugin": "2.0.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "turbo": "^2.5.6"
  }
}
